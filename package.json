{
  "name": "books",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next.mjs dev -H 127.0.0.1",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "node scripts/next.mjs typegen && tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx scripts/demo.ts",
    "dev:demo": "node scripts/next.mjs dev -H 127.0.0.1 -p 3001 --demo",
    "start:demo": "node scripts/next.mjs start -H 127.0.0.1 -p 3001 --demo",
    "db:generate": "drizzle-kit generate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.6",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
